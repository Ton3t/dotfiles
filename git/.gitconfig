[user]
	name = Ton3t
	email = elton3t@gmail.com
[init]
	defaultBranch = main
[pull]
	rebase = false
[core]
	editor = nvim
	autocrlf = input
	excludesfile = /home/tonet/.gitignore_global
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[fetch]
	prune = true
[color]
	ui = auto
[alias]
	st = status
	co = checkout
	br = branch
	cm = commit
	last = log -1 HEAD
	lg = log --oneline --graph --decorate --all
